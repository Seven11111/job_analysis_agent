# ── 本地项目配置 ───────────────────────────────────────────────
# SQLite 文件路径；相对路径始终相对于 job_analysis_agent 项目根目录。
DATABASE_PATH=./data/job_analysis.db
# 真实实习岗位搜索至少启用一个来源：job-pro 或 BOSS；两者可同时配置。
# fixture 仅用于离线开发/流程演示，不会返回真实岗位。
# 后端未收到显式来源时使用该默认值；真实搜索时请设为 job_pro 或 boss_agent_cli。
JOB_PROVIDER=fixture
# 公开岗位链接抓取的最长等待时间（秒），包含 JavaScript 页面渲染。
IMPORT_TIMEOUT_SECONDS=15
# 浏览器前端 origin，多个地址用英文逗号分隔。
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5175,http://localhost:5175
LOG_LEVEL=INFO

# ── BOSS 直聘（只读实习岗位搜索来源，按需配置）─────────────────
# 安装脚本将 CLI 安装到 .tools/bin/boss；相对路径固定按项目根目录解析，不依赖全局 PATH。
BOSS_CLI_COMMAND=./.tools/bin/boss
# 单次搜索超时与本机登录引导等待上限（秒）。
BOSS_CLI_TIMEOUT_SECONDS=30
BOSS_LOGIN_TIMEOUT_SECONDS=180
# 使用项目专用的可见 Chrome/CDP 会话；项目不会收集或上传密码、验证码、Cookie。
BOSS_BROWSER_SOURCE=existing-browser
BOSS_CDP_URL=http://127.0.0.1:9222
# 可选：Chrome/Chromium 可执行文件路径；留空时由 CLI/系统默认发现。
BOSS_CHROME_PATH=
# 专用浏览器用户目录，用于保存该项目登录态；不要指向日常个人浏览器目录。
BOSS_CHROME_PROFILE_PATH=~/.boss-agent/chrome-profile
# 是否允许项目启动专用 Chrome（true/false）。
BOSS_AUTO_START_CHROME=true
# BOSS 返回 code 37 后停止后续城市请求的冷却秒数。
BOSS_RISK_COOLDOWN_SECONDS=900

# ── job-pro（公开招聘 API 聚合 CLI，实习岗位搜索来源，按需配置）─
# 安装脚本将包固定安装到 .tools/job-pro；路径按项目根目录解析。
JOB_PRO_COMMAND=./.tools/job-pro/node_modules/.bin/job-pro
JOB_PRO_TIMEOUT_SECONDS=45
# 公司来源 ID，英文逗号分隔；固定的 job-pro 1.2.1 支持以下 50 家。
# 使用 job-pro list 可查看公司及其上游来源；若只想搜索部分公司，可删减此列表。
JOB_PRO_COMPANIES=tencent,bytedance,alibaba,meituan,xiaohongshu,jd,kuaishou,baidu,netease,didi,bilibili,pdd,huawei,weibo,mihoyo,pingan,trip,unitree,byd,antgroup,liauto,sf,oppo,xiaomi,nio,minimax,moonshot,zhipu,iqiyi,agibot,lilith,zerooneai,baichuan,sensetime,horizonrobotics,vivo,iflytek,megvii,deepseek,galaxyuniversal,stepfun,cambricon,geely,xpeng,weride,hoyoverse,hikvision,cicc,cainiao,webank
# 本项目只搜实习岗位，不自动投递。
JOB_PRO_SCOPE=intern

# ── Offer 先生（可选，官方校招资讯 API）─────────────────────────
# 在开放平台个人中心创建 API Key；仅后端使用，不会返回给浏览器。
# Key 管理：https://developer.offerxiansheng.com/account/api-keys
# API 指南：https://developer.offerxiansheng.com/docs/ai/guides
OFFER_XIANSHENG_TIMEOUT_SECONDS=20
OFFER_XIANSHENG_API=

# ── LiteLLM（可选，岗位分析和求职 Agent）────────────────────────
# Provider 是 LiteLLM 的路由前缀。OpenAI 兼容 API（包括自定义兼容地址）一般填 openai；
# 常见原生 Provider 示例：openrouter、anthropic、gemini、deepseek、ollama、azure、bedrock。
# 完整且随版本变化的列表：https://docs.litellm.ai/docs/providers
LITELLM_PROVIDER=openai
# 服务商给出的模型 ID；项目会按 LITELLM_PROVIDER 补充路由前缀。
LITELLM_MODEL=
# 当前适配器传给 LiteLLM 的 API Key 和可选 API 根地址；兼容 API 地址通常以 /v1 结尾。
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=60
